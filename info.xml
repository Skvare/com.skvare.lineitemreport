<?xml version="1.0"?>
<extension key="com.skvare.lineitemreport" type="module">
  <file>lineitemreport</file>
  <name>Line Item Report</name>
  <description>Provides reports with price set columns and filters for participants, contributions, and memberships</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Skvare</author>
    <email>info@skvare.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">http://skvare.com</url>
    <url desc="Documentation">http://skvare.com</url>
    <url desc="Support">http://skvare.com</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2019-05-17</releaseDate>
  <version>1.2</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.27</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/Lineitemreport</namespace>
    <format>25.01.1</format>
  </civix>
  <mixins>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
